		sgpio0: sgpio@33201c00 {
			compatible = "axiado,sgpio";
			reg = <0x0 0x33201c00 0x00 0x400>;
			gpio-controller;
			#gpio-cells = <2>;
			interrupt-parent = <&gic500>;
			interrupts = <GIC_SPI 125 IRQ_TYPE_LEVEL_HIGH>;
			design-variant = <512>;
			/* Supports maximum of 128 pins */
			ngpios = <128>;
			/* SGPIO Clock Frequency 12 MHz */
			bus-frequency = <12000000>;
			apb-frequency = <100000000>;
			dout-init = <0x00000000 0x00000000 0x00000000 0x00000000>;
			status = "disabled";
		};

		pcie_x1: pcie@45200000 {
			compatible = "axiado,ax3005-pcie";
			status = "disabled";
			device_type = "pci";
			device_role = "vga";                    /* VGA Controller */
			reg = <0 0x45200000 0 0x1000>,          /* PADS XPA reg */
			      <0 0x45300000 0 0x4000>,        /* AFI PHY reg */
			      <0 0x45202000 0 0x1000>,        /* bridge space */
			      <0 0x45203000 0 0x1000>,        /* pcie config space */
			      <0 0x45280000 0 0x8000>,        /* MBX reg */
			      <0 0x45240000 0 0x1000>,        /* EXT reg */
			     <0 0x33202400 0 0x100>;           /* IOCTL reg */
			reg-names = "csr", "phy", "bridge", "cfg", "mbx", "ext", "ioctl";
			#address-cells = <3>;
			#size-cells = <2>;
			interrupt-parent = <&gic500>;
			#interrupt-cells = <1>;
			interrupts = <GIC_SPI 33 IRQ_TYPE_LEVEL_HIGH>,  /* MSI interrupt */
				     <GIC_SPI 34 IRQ_TYPE_LEVEL_HIGH>,       /* Msgbox */
				     <GIC_SPI 40 IRQ_TYPE_LEVEL_HIGH>;       /* Mailbox 0 */
			interrupt-names = "msi", "msgbox", "mailbox";
			interrupt-map-mask = <0 0 0 7>;
			interrupt-map = <0 0 0 1 &gic500 0>,
					<0 0 0 2 &gic500 1>,
					<0 0 0 3 &gic500 2>,
					<0 0 0 4 &gic500 3>;
			num-lanes = <1>;
			bus-range = <0x00 0xff>;
			ranges = <0x83000000 0 0x00000000 0 0x89300000 0 0x100000
				 0xc3000000 0 0x00000000 0 0x8c000000 0 0x4000000>;

			pci0: pci@1,0 {
				device_type = "pci";
				assigned-addresses = <0x83000800 0x7 0xE0000000 0 0x400000>; //conf
				reg = <0x00800 0 0 0 0>;
				#address-cells = <3>;
				#size-cells = <2>;
				ranges;
			};
		};

		hcp@43000000 {
			compatible = "axiado,ax3005-hcp";
			#address-cells = <1>;
			#size-cells = <0>;
			/*
			 * Memory regions for the HCP subsystem:
			 * - SHIM registers
			 * - PHY CSR
			 */
			reg = <0x0 0x43100000 0x0 0x4000>,    /* SHIM regs (16KB) */
			      <0x0 0x47000000 0x0 0x50000>;   /* PHY CSR (320KB) */
			reg-names = "shim", "phy-csr";

			/*
			 * Interrupts for HCP:
			 * IRQ 0-4: MACs 0-4
			 */
			interrupt-parent = <&gic500>;
			interrupts = <GIC_SPI 5 IRQ_TYPE_LEVEL_HIGH>,  /* MAC 0 (XGMII) */
				     <GIC_SPI 6 IRQ_TYPE_LEVEL_HIGH>,  /* MAC 1 (GMII0) */
				     <GIC_SPI 7 IRQ_TYPE_LEVEL_HIGH>,  /* MAC 2 (GMII1) */
				     <GIC_SPI 8 IRQ_TYPE_LEVEL_HIGH>,  /* MAC 3 (GMII2) */
				     <GIC_SPI 9 IRQ_TYPE_LEVEL_HIGH>;  /* MAC 4 (GMII3) */
			interrupt-names = "xgmii", "gmii0", "gmii1", "gmii2", "gmii3";

			mac0: mac@0 {
				reg = <0>;
				compatible = "axiado,ax3005-mac";
				phy-mode = "rxaui";
				status = "disabled";
			};

			mac1: mac@1 {
				reg = <1>;
				compatible = "axiado,ax3005-mac";
				phy-mode = "sgmii";
				status = "disabled";
			};

			mac2: mac@2 {
				reg = <2>;
				compatible = "axiado,ax3005-mac";
				phy-mode = "sgmii";
				status = "disabled";
			};

			mac3: mac@3 {
				reg = <3>;
				compatible = "axiado,ax3005-mac";
				phy-mode = "sgmii";
				status = "disabled";
			};

			mac4: mac@4 {
				reg = <4>;
				compatible = "axiado,ax3005-mac";
				phy-mode = "sgmii";
				status = "disabled";
			};

			mdio: mdio {
				compatible = "axiado,ax3005-mdio";
				#address-cells = <1>;
				#size-cells = <0>;
			};

			hfifo: hfifo {
				compatible = "axiado,ax3005-hfifo";
				mac = <1>;
			};
		};

