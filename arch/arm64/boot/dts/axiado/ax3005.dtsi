		disp_ctrl: disp_ctrl@40c00000 {
			compatible = "axiado,drm-db9000";
			reg = <0x0 0x40c00000 0x0 0x1000>;
			memory-region = <&pci_ep_disp>;
			interrupts = <GIC_SPI 14 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&clk_mali &clk_pclk>;
			clock-names = "clk_mali", "clk_pclk";
			bits-per-pixel = <32>;
			bus-width = <24>;
			paddr-disp = <0x8c000000>;
			status = "disabled";
			disp_out: port {
				#address-cells = <1>;
				#size-cells = <0>;
				disp_out_hdmi: endpoint@0 {
					reg = <0>;
					remote-endpoint = <&hdmi_in_disp>;
				};
			};
		};

		hdmi: hdmi@40c11000 {
			compatible ="axiado,ax3000-hdmi";
			reg = <0x00 0x40c11000 0x00 0x4000>;
			memory-region = <&pci_ep_disp>;
			interrupts = <GIC_SPI 16 IRQ_TYPE_LEVEL_HIGH>;
			clocks =  <&clk_mali>, <&clk_pclk>;
			clock-names = "clk_mali", "clk_pclk";
			#address-cells = <1>;
			#size-cells = <0>;
			status = "disabled";
			hdmi_in: port {
				#address-cells = <1>;
				#size-cells = <0>;
				status = "disabled";
				hdmi_in_disp: endpoint@0 {
					reg = <0>;
					remote-endpoint = <&disp_out_hdmi>;
				};
			};
		};

		video: video {
			compatible = "axiado,ax3000-video";
			memory-region = <&pci_ep_disp>;
		};

		emmc_phy: emmc-phy@33301c00 {
			compatible = "axiado,ax3000-emmc-phy";
			reg = <0x00 0x33301c00 0x00 0x100>;
			#phy-cells = <0>;
			status = "disabled";
		};

		sdhci0: mmc@46000000 {
			compatible = "axiado,ax3000-sdhci-5.1-emmc", "arasan,sdhci-5.1";
			reg = <0x0 0x46000000 0x00 0x1000>;
			clock-names = "clk_xin", "clk_ahb";
			clocks = <&clk_xin &clk_xin>;
			interrupt-parent = <&gic500>;
			interrupts = <GIC_SPI 123 IRQ_TYPE_LEVEL_HIGH>;
			phys = <&emmc_phy>;
			phy-names = "phy_arasan";
			status = "disabled";
		};
