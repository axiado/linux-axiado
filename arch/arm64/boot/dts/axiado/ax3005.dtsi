			status = "disabled";
		};

		i2c21: i2c@330c0c00 {
			compatible = "cdns,i2c-r1p14";
			reg = <0x0 0x330c0c00 0x0 0x400>;
			clocks = <&pclk>;
			interrupt-parent = <&gic500>;
			interrupts = <GIC_SPI 217 IRQ_TYPE_LEVEL_HIGH>;
			#address-cells = <1>;
