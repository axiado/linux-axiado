			status = "disabled";
		};

		i2c22: i2c@331a0800 {
			compatible = "cdns,i2c-r1p14";
			reg = <0x0 0x331a0800 0x0 0x400>;
			clocks = <&pclk>;
			interrupt-parent = <&gic500>;
			interrupts = <GIC_SPI 218 IRQ_TYPE_LEVEL_HIGH>;
			#address-cells = <1>;
